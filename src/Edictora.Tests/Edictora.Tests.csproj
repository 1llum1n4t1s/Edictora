<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.5.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Edictora.Core\Edictora.Core.csproj" />
    <ProjectReference Include="..\Edictora.Cli\Edictora.Cli.csproj" />
    <ProjectReference Include="..\Edictora.UI\Edictora.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ReplaceTranslator の掲載文（正本）の写し。2026-11-13 の検証で使った切り出し（push.mjs）と
      同じ結果になることを、ReplaceTranslator リポジトリが無い環境（CI）でも確かめるために同梱する。
    -->
    <None Update="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
