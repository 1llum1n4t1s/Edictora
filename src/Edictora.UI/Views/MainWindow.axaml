<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Edictora.UI.ViewModels"
        x:Class="Edictora.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Edictora — Chrome Web Store 掲載情報の一括更新"
        Icon="avares://Edictora.UI/Assets/app.ico"
        Width="1280" Height="820"
        MinWidth="980" MinHeight="640"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32"
        WindowStartupLocation="CenterScreen">

  <Panel>
    <!--  ウィンドウ背景：アクリルブラー  -->
    <ExperimentalAcrylicBorder IsHitTestVisible="False">
      <ExperimentalAcrylicBorder.Material>
        <ExperimentalAcrylicMaterial
            BackgroundSource="Digger"
            TintColor="{DynamicResource Color.Window}" />
      </ExperimentalAcrylicBorder.Material>
    </ExperimentalAcrylicBorder>

    <Grid Margin="16,36,16,16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">

      <!--  ━━━ 設定ファイル ━━━  -->
      <Border Grid.Row="0" Classes="card">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto">
          <TextBlock Grid.Column="0" Classes="label" Text="設定ファイル" />
          <TextBox Grid.Column="1" IsReadOnly="True" Text="{Binding ConfigPath}" />
          <Button Grid.Column="2" Content="開く..." Command="{Binding BrowseConfigCommand}" />
          <Button Grid.Column="3" Content="再読込" Command="{Binding ReloadConfigCommand}"
                  ToolTip.Tip="正本ファイルを読み直して一覧を作り直します（ダッシュボードには接続しません）" />
          <Button Grid.Column="4" Content="フォルダ" Command="{Binding OpenConfigFolderCommand}" />
          <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,6,0,0"
                     Classes="label" Text="{Binding ConfigSummary}" TextTrimming="CharacterEllipsis" />
        </Grid>
      </Border>

      <!--  ━━━ 操作 ━━━  -->
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
        <Button Content="ログイン" Command="{Binding LoginCommand}"
                ToolTip.Tip="専用プロファイルの Chrome を開きます。Google へのログインはご自身で行ってください" />
        <Button Classes="accent" Content="現在値を取得" Command="{Binding FetchCommand}"
                ToolTip.Tip="ダッシュボードから現在値を読み出して正本と比べます（読み取りのみ）" />
        <Button Content="チェックした行を下書き保存" Command="{Binding PushCheckedCommand}"
                ToolTip.Tip="差分のある欄だけを書き換えて下書き保存し、読み直して照合します。審査には送信しません" />
        <Button Content="選択中のアイテムを審査に送信..." Command="{Binding SubmitSelectedCommand}"
                ToolTip.Tip="選択中の行のアイテム 1 件を審査に送信します（確認ダイアログが出ます）" />
        <Button Content="中止" Command="{Binding CancelCommand}" />
        <Button Content="ログ" Command="{Binding OpenLogFolderCommand}" />
      </StackPanel>

      <!--  ━━━ 一覧 + 比較 ━━━  -->
      <Grid Grid.Row="2" ColumnDefinitions="360,*" ColumnSpacing="12">
        <Border Grid.Column="0" Classes="card" Padding="6">
          <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ListingRowViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}"
                            ToolTip.Tip="下書き保存の対象にする" />
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ItemName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="label" Text="{Binding Locale}" />
                  </StackPanel>
                  <Border Grid.Column="2" Classes="status"
                          Classes.match="{Binding IsMatch}"
                          Classes.different="{Binding IsDifferent}"
                          Classes.error="{Binding IsError}">
                    <TextBlock Text="{Binding StatusLabel}" FontSize="12" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <Border Grid.Column="1" Classes="card">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" DataContext="{Binding SelectedRow}" x:DataType="vm:ListingRowViewModel">
              <TextBlock Classes="h1" Margin="0">
                <Run Text="{Binding ItemName}" />
                <Run Text=" — " />
                <Run Text="{Binding Locale}" />
              </TextBlock>
              <TextBlock Classes="label" Text="{Binding ItemId}" />
              <TextBlock Foreground="{DynamicResource Brush.Danger}" Text="{Binding ErrorText}" TextWrapping="Wrap"
                         IsVisible="{Binding IsError}" />
              <ItemsControl ItemsSource="{Binding Fields}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FieldComparisonViewModel">
                    <StackPanel Spacing="6" Margin="0,0,0,12">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                        <TextBlock Classes="label" Text="{Binding StatusLabel}" />
                      </StackPanel>
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <StackPanel Grid.Column="0" Spacing="4">
                          <TextBlock Classes="label" Text="ダッシュボードの現在値" />
                          <TextBox IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                   MaxHeight="360" Text="{Binding Current}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                          <TextBlock Classes="label" Text="正本" />
                          <TextBox IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                   MaxHeight="360" Text="{Binding Expected}" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <!--  ━━━ 進捗とログ ━━━  -->
      <Border Grid.Row="3" Classes="card" Padding="10">
        <StackPanel Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ProgressBar IsIndeterminate="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Width="120" />
            <TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" />
          </StackPanel>
          <ScrollViewer x:Name="LogScroll" Height="110">
            <ItemsControl ItemsSource="{Binding LogLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <SelectableTextBlock Classes="label" Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>
    </Grid>
  </Panel>
</Window>
